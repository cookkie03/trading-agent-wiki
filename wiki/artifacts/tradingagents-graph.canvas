		{"id":"llm_clients","type":"text","text":"**`tradingagents/llm_clients/`**\n\n`create_llm_client(provider, model, base_url, **kwargs)`\n→ `deep_thinking_llm`, `quick_thinking_llm`\n\nProviders: OpenAI, Anthropic, Google, Azure, MiniMax, DeepSeek, Ollama.\n\nKwargs: `thinking_level` (Google), `reasoning_effort` (OpenAI), `effort` (Anthropic).","x":700,"y":145,"width":720,"height":240,"color":"6"},
